APP_NAME=Solmir
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://solmir.ir

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

# Application Maintenance
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Logging Configuration (warning level recommended for lean production logs)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Configuration (Production: MySQL / MariaDB on DirectAdmin)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=solmir_db
DB_USERNAME=solmir_user
DB_PASSWORD=

# Session Configuration (Database driver ensures reliable multi-process sessions)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache Configuration (file cache avoids DB roundtrips and Redis requirements on shared hosting)
CACHE_STORE=file
# CACHE_STORE=database

# Queue Configuration (database queue works without Supervisor via Cron runner)
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public

# Mail Configuration (Production: SMTP via DirectAdmin Exim or external SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="solmirofc@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# OpenGraph Image (Optional absolute or relative path, e.g. /images/og-cover.png)
APP_OG_IMAGE=

VITE_APP_NAME="${APP_NAME}"
